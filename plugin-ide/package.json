{
  "name": "saas-workflow-ide-plugin",
  "displayName": "Asisten Joe - Micro-Scoped Prompt Slicer Engine",
  "description": "Asisten Joe v9.8.0: Micro-Scoped Prompt Slicer Engine (Pemotong Prompt Presisi Mikro 1-Berkas & Single-Component Lock, Kontrak Embargo Area Dilarang Sentuh, Mode Design & Grafity Super-Prompt, Multi-Agent Swarm, Inline CodeLens & Hover Guard, Terminal Error Sensor, Real-Time Token Streaming, Native Antigravity AI Engine).",
  "version": "9.8.0",
  "publisher": "joecompanyagent-lab",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "bin": {
    "saas-workflow-init": "./cli.js"
  },
  "activationEvents": [
    "onView:saasWorkflow.chatView",
    "onCommand:saasWorkflow.openChatTab",
    "onCommand:saasWorkflow.initProject",
    "onCommand:saasWorkflow.createFeatureBranch",
    "onCommand:saasWorkflow.auditVibeCoding",
    "onCommand:saasWorkflow.generatePromptForBlock"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Asisten Joe Pengaturan",
      "properties": {
        "saasWorkflow.apiKey": {
          "type": "string",
          "default": "",
          "description": "Kunci API Opsional (Gemini API / Antigravity API Key) jika berjalan di luar Antigravity IDE."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "saasWorkflowExplorer",
          "title": "Asisten Joe",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "saasWorkflowExplorer": [
        {
          "type": "webview",
          "id": "saasWorkflow.chatView",
          "name": "Asisten Joe"
        }
      ]
    },
    "commands": [
      {
        "command": "saasWorkflow.openChatTab",
        "title": "Buka Asisten Joe AI Chat",
        "icon": "$(shield)"
      },
      {
        "command": "saasWorkflow.auditVibeCoding",
        "title": "Asisten Joe: Audit Kualitas & Keamanan Vibe Coding (v9.8.0)"
      },
      {
        "command": "saasWorkflow.initProject",
        "title": "Asisten Joe: Inisialisasi Cetakan Proyek (Setup Blueprint)"
      },
      {
        "command": "saasWorkflow.createFeatureBranch",
        "title": "Asisten Joe: Buat Ruang Kerja Fitur Baru"
      },
      {
        "command": "saasWorkflow.generatePromptForBlock",
        "title": "Asisten Joe: Susun Prompt Modul Ini"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "saasWorkflow.openChatTab",
          "icon": "$(shield)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "start": "node cli.js"
  },
  "dependencies": {}
}
