{
  "name": "saas-workflow-ide-plugin",
  "displayName": "Asisten Joe - Full Stack Laravel & Blade Archetype Engine",
  "description": "Asisten Joe v10.11.0: Full Stack Laravel & Blade Archetype Engine (Archetype Resmi AI Assistant & Senior Full Stack Architect Laravel 11/12 & Blade Component Engine, Evaluasi Prompt Terstruktur, Enterprise SaaS Gitflow feature/* & hotfix/* Dual-Merge, Groq LLaMA 3.3 70B 3x Key Pool Auto-Failover, Object-Agnostic Emergency Brakes).",
  "version": "10.11.0",
  "publisher": "joecompanyagent-lab",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "bin": {
    "saas-workflow-init": "./cli.js"
  },
  "activationEvents": [
    "onView:saasWorkflow.chatView",
    "onCommand:saasWorkflow.openChatTab",
    "onCommand:saasWorkflow.initProject",
    "onCommand:saasWorkflow.createFeatureBranch",
    "onCommand:saasWorkflow.auditVibeCoding",
    "onCommand:saasWorkflow.generatePromptForBlock"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Asisten Joe Pengaturan",
      "properties": {
        "saasWorkflow.apiKey": {
          "type": "string",
          "default": "",
          "description": "Kunci API Opsional (Gemini API / Antigravity API Key) jika berjalan di luar Antigravity IDE."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "saasWorkflowExplorer",
          "title": "Asisten Joe",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "saasWorkflowExplorer": [
        {
          "type": "webview",
          "id": "saasWorkflow.chatView",
          "name": "Asisten Joe"
        }
      ]
    },
    "commands": [
      {
        "command": "saasWorkflow.openChatTab",
        "title": "Buka Asisten Joe AI Chat",
        "icon": "$(shield)"
      },
      {
        "command": "saasWorkflow.auditVibeCoding",
        "title": "Asisten Joe: Audit Kualitas & Keamanan Vibe Coding (v10.7.0)"
      },
      {
        "command": "saasWorkflow.initProject",
        "title": "Asisten Joe: Inisialisasi Cetakan Proyek (Setup Blueprint)"
      },
      {
        "command": "saasWorkflow.createFeatureBranch",
        "title": "Asisten Joe: Buat Ruang Kerja Fitur Baru"
      },
      {
        "command": "saasWorkflow.generatePromptForBlock",
        "title": "Asisten Joe: Susun Prompt Modul Ini"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "saasWorkflow.openChatTab",
          "icon": "$(shield)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "start": "node cli.js"
  },
  "dependencies": {}
}
